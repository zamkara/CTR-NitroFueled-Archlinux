# Native Arch Linux runtime and launcher packaging.
pkgname=ctr-nitrofueled
pkgver=0.r0.g46c810b2a304
pkgrel=1
pkgdesc='Crash Team Racing Nitro-Fueled native runtime and GTK launcher for Arch Linux'
arch=('x86_64')
url='https://github.com/zamkara/CTR-NitroFueled'
license=('GPL-2.0-or-later' 'MIT' 'Bitstream-Vera' 'Arev')
depends=('glibc' 'gcc-libs' 'vulkan-icd-loader' 'sdl3' 'ffmpeg' 'fmt' 'xxhash'
         'zydis' 'libx11' 'python' 'python-gobject' 'gtk4' 'libadwaita' 'xdg-utils' 'xdg-terminal-exec' 'mangohud' 'libxkbcommon' 'xkeyboard-config')
makedepends=('git' 'cmake' 'ninja' 'pkgconf' 'boost' 'robin-map' 'vulkan-headers'
             'glslang' 'spirv-tools')
checkdepends=('xorg-server-xvfb' 'xorg-xauth' 'ttf-dejavu' 'desktop-file-utils' 'dbus')
optdepends=('vulkan-driver: Vulkan 1.3 capable GPU driver'
            'vulkan-tools: GPU diagnostics' 'gamemode: game performance management')
options=('!lto' '!debug')
# Local builds use the checked-out commit; CI replaces this line with a literal release pin.
_commit=${CTR_COMMIT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse HEAD)}
[[ $_commit =~ ^[0-9a-f]{40}$ ]] || return 1
_upstream=${CTR_UPSTREAM:-46c810b2a30451873034e5b17c8a61ddd780618f}
[[ $_upstream =~ ^[0-9a-f]{40}$ ]] || return 1
source=("ctr-nitrofueled-source::git+https://github.com/GetLostIn/CTR-NitroFueled-PC.git#commit=$_upstream"
        "ctr-native-policy::git+https://github.com/zamkara/CTR-NitroFueled.git#commit=$_commit"
        'vk_mem_alloc.h::https://raw.githubusercontent.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator/v3.3.0/include/vk_mem_alloc.h')
sha256sums=('SKIP' 'SKIP' '90ce12fc4a2466235a09ae02905dd0c13aee80c1bbf11b331ab61230c2ceb112')

pkgver() {
    cd "$srcdir/ctr-nitrofueled-source"
    local policy_count source_count digest
    policy_count=$(git -C "$srcdir/ctr-native-policy" rev-list --count "$_commit")
    source_count=$(git rev-list --count "$_upstream")
    digest=$(printf '%s\n%s\n' "$_commit" "$_upstream" | sha256sum | cut -c1-12)
    printf '0.r%s.u%s.g%s' "$policy_count" "$source_count" "$digest"
}

prepare() {
    cd "$srcdir/ctr-nitrofueled-source"
    python "$srcdir/ctr-native-policy/.github/workflows/ctr/materialize.py" --source "$PWD" --policy "$srcdir/ctr-native-policy"
    git submodule update --init --recursive
    # Supply the exact VMA header; magic_enum and xbyak come from pinned submodules.
    # Avoid tools/deps.sh fetching additional tag-based checkouts during build().
    install -Dm644 "$srcdir/vk_mem_alloc.h" out/deps/prefix/include/vk_mem_alloc.h
}

build() {
    cd "$srcdir/ctr-nitrofueled-source"
    export BB_PGO=off BB_LTO=OFF CMAKE_BUILD_PARALLEL_LEVEL=2
    # ninja is called directly by upstream, so its job limit needs a small wrapper.
    install -d "$srcdir/build-tools"
    printf '#!/bin/sh\nexec /usr/bin/ninja -j2 "$@"\n' > "$srcdir/build-tools/ninja"
    chmod 755 "$srcdir/build-tools/ninja"
    export PATH="$srcdir/build-tools:$PATH"
    export BB_GPU_USER_DIR="$srcdir/test-user"
    install -d "$BB_GPU_USER_DIR"
    bash build.sh --test
    cmake --build out/gpu --target settings-test
    out/gpu/settings-test
    printf 'native-%s-upstream-%s\n' "$_commit" "$_upstream" > out/VERSION
}

check() {
    cd "$srcdir/ctr-nitrofueled-source"
    export BB_GPU_USER_DIR="$srcdir/test-user"
    install -d "$BB_GPU_USER_DIR"
    desktop-file-validate "$srcdir/ctr-nitrofueled-source/packaging/arch/ctr-nitrofueled.desktop" "$srcdir/ctr-nitrofueled-source/packaging/arch/ctr-nitrofueled-play.desktop"
    dbus-run-session -- xvfb-run -a env GSK_RENDERER=cairo python -m unittest discover -s tests -p 'test_*.py'
}

package() {
    cd "$srcdir/ctr-nitrofueled-source"
    local dest="$pkgdir/usr/lib/ctr-nitrofueled"
    install -Dm755 out/sacredfire "$dest/bin/sacredfire"
    install -Dm755 out/bb-gpu-capabilities "$dest/bin/bb-gpu-capabilities"
    install -Dm755 out/gpu/libbbgpu.so "$dest/bin/gpu/libbbgpu.so"
    install -Dm755 packaging/arch/install.sh "$dest/install.sh"
    install -Dm755 run.sh "$dest/run.sh"
    # run.py remains available for upstream tooling; Linux uses run.sh.
    install -Dm644 run.py "$dest/run.py"
    install -Dm644 out/VERSION "$dest/VERSION"
    cp -a launcher scripts patches "$dest/"
    install -Dm644 tools/merge_update.py "$dest/tools/merge_update.py"
    install -Dm644 tools/gen_import_names.py "$dest/tools/gen_import_names.py"
    find "$dest" -type d -name __pycache__ -prune -exec rm -rf {} +
    python - "$dest/build-info.json" "$pkgver-$pkgrel" "$_commit" "$_upstream" <<'PYBUILD'
import json,pathlib,sys
pathlib.Path(sys.argv[1]).write_text(json.dumps({'package_version':sys.argv[2], 'commit':sys.argv[3], 'upstream':sys.argv[4]},indent=2)+'\n')
PYBUILD
    install -Dm755 "$srcdir/ctr-nitrofueled-source/packaging/arch/ctr-nitrofueled" "$pkgdir/usr/bin/ctr-nitrofueled"
    install -Dm644 "$srcdir/ctr-nitrofueled-source/packaging/arch/ctr-nitrofueled.desktop" "$pkgdir/usr/share/applications/ctr-nitrofueled.desktop"
    install -Dm644 "$srcdir/ctr-nitrofueled-source/packaging/arch/ctr-nitrofueled-play.desktop" "$pkgdir/usr/share/applications/ctr-nitrofueled-play.desktop"
    install -Dm644 launcher/assets/app-icon.png "$pkgdir/usr/share/pixmaps/ctr-nitrofueled.png"
    install -Dm644 "$srcdir/vk_mem_alloc.h" "$pkgdir/usr/share/licenses/ctr-nitrofueled/VulkanMemoryAllocator-header"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ctr-nitrofueled/LICENSE"
    for component in gpu/third_party/fonts gpu/third_party/fsr-vulkan gpu/third_party/imgui third_party/LibAtrac9 gpu/third_party/magic_enum gpu/third_party/miniz gpu/third_party/xbyak; do
        for file in "$component"/LICENSE* "$component"/LICENCE* "$component"/COPYING*; do
            [[ ! -f $file ]] || install -Dm644 "$file" "$pkgdir/usr/share/licenses/ctr-nitrofueled/$(basename "$component")-$(basename "$file")"
        done
    done
    install -Dm644 README.md "$pkgdir/usr/share/doc/ctr-nitrofueled/README.md"
    for doc in FEATURES.md CUSA14876.md UPSTREAM.md; do
        [[ ! -f docs/$doc ]] || install -Dm644 "docs/$doc" "$pkgdir/usr/share/doc/ctr-nitrofueled/docs/$doc"
    done
}

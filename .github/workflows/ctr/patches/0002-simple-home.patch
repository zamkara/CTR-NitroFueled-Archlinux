index e3887f9c5287d119ffba6cd037258520b60ceb4c..5a3a892377bfe5f145659012f9f51bc963e96663 100644
--- c/launcher/steam_shortcuts.py
+++ w/launcher/steam_shortcuts.py
@@ -7,6 +7,7 @@ ended by 0x08). The app id of a shortcut is the CRC32 of its executable and name
 set, as Steam computes it (the same id names its grid artwork).
 """
 import os
+import shutil
 import struct
 import subprocess
 import zlib
@@ -167,3 +168,24 @@ def launcher_command():
     else:
         exe = str((Path(__file__).resolve().parent / "bb-launcher.sh"))
     return exe, str(Path(exe).parent), "--play"
+
+
+def install_artwork(shortcuts_path, entry, assets):
+    """Install supplied artwork, preserving the previous image once before replacement."""
+    grid = Path(shortcuts_path).parent / "grid"
+    grid.mkdir(parents=True, exist_ok=True)
+    appid = entry["appid"] & 0xFFFFFFFF
+    for suffix, name in (("p", "ic_grid.png"), ("_hero", "ic_heroes.png"),
+                         ("_logo", "ic_logo.png")):
+        source = Path(assets) / name
+        target = grid / f"{appid}{suffix}.png"
+        if not source.is_file():
+            continue
+        if target.exists() and target.read_bytes() == source.read_bytes():
+            continue
+        backup = target.with_suffix(".png.bak")
+        if target.exists() and not backup.exists():
+            shutil.copy2(target, backup)
+        temporary = target.with_suffix(".png.tmp")
+        shutil.copy2(source, temporary)
+        os.replace(temporary, target)
